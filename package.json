{
  "name": "upstash-redis-level",
  "description": "@upstash/redis backed abstract-level database for Node.js",
  "version": "1.1.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "keywords": [
    "level",
    "leveldb",
    "leveldown",
    "levelup",
    "memory",
    "upstash",
    "redis"
  ],
  "bugs": {
    "url": "https://github.com/tinacms/upstash-redis-level/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinacms/upstash-redis-level.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:suite": "pnpm run build && node ./src/suite.test.js",
    "types": "tsc --noEmit",
    "version": "pnpm exec changeset version",
    "version:snapshot": "pnpm exec changeset version --snapshot",
    "release": "npm publish --access public --provenance",
    "release:beta": "npm publish --tag beta --access public --provenance"
  },
  "dependencies": {
    "@upstash/redis": "1.24.3",
    "abstract-level": "1.0.3",
    "module-error": "^1.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "2.24.3",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.6",
    "tape": "^5.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.1.2"
}
